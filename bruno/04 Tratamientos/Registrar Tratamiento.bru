meta {
  name: Registrar Tratamiento
  type: http
  seq: 1
}

post {
  url: http://localhost:3000/tratamientos
  body: json
  auth: inherit
}

body:json {
  {
    "nombre": "Fungicida Cúprico",
    "tipo": "quimico",
    "dosis": "2.5 g/L",
    "frecuencia": "Cada 7 días",
    "descripcionAplicacion": "Foliar al primer síntoma de infección",
    "enfermedadId": 1
  }
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
