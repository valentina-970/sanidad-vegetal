meta {
  name: Registrar Susceptibilidad
  type: http
  seq: 1
}

post {
  url: http://localhost:3000/susceptibilidades
  body: json
  auth: inherit
}

body:json {
  {
    "plantaId":1,
    "enfermedadId":1,
    "nivel": "alta"
  }
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
