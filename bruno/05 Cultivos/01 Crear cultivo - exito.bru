meta {
  name: 01 Crear cultivo - exito
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/cultivos
  body: json
  auth: none
}

body:json {
  {
    "plantaId": 2,
    "loteFinca": "Finca La Palma - Lote 1",
    "region": "Huila",
    "fechaSiembra": "2026-04-01",
    "codigoGeneticoSemilla": "ATGCGCGATATCGCGTACGA"
  }
}

script:post-response {
  bru.setVar("cultivoId", res.body.id);
}

assert {
  res.status: eq 201
}
