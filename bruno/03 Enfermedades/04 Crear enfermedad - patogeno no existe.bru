meta {
  name: 04 Crear enfermedad - patogeno no existe
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/enfermedades
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Marchitez por Fusarium",
    "sintomas": "Amarillamiento foliar y marchitez progresiva",
    "epocaRiesgo": "verano",
    "patogenoId": 999999
  }
}

assert {
  res.status: eq 404
}
