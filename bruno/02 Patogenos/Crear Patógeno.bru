meta {
  name: Crear Patógeno
  type: http
  seq: 1
}

post {
  url: http://localhost:3000/patogenos
  body: json
  auth: inherit
}

body:json {
  {
    "nombre": "Fusarium oxysporum",
    "nombreCientifico": "Fusarium oxysporum f. sp. lycopersici",
    "tipo": "hongo",
    "descripcion": "Agente causal del marchitamiento vascular",
    "formaTransmision": "suelo",
    "secuenciaGenetica": "ATCGGCTAAGCT"
  }
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
