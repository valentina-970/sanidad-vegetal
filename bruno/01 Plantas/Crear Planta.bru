meta {
  name: Crear Planta
  type: http
  seq: 1
}

get {
  url: http://localhost:3000/plantas
  body: json
  auth: inherit
}

body:json {
  {
    "nombreComun": "Tomate",
    "nombreCientifico": "Solanum lycopersicum",
    "familia": "Solanaceae"
  }
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
